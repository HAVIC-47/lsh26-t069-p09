# Supabase — Project Settings > API
# Copy to .env.local and fill in. Never commit the filled-in file.

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# "anon" / "publishable" key — safe in the browser, RLS applies to it
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# "service_role" / "secret" key — BYPASSES row-level security.
# Server-side only. Never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
